# Generated by data-deploy (toolkit) -- Lakeflow Connect ingestion pipeline resource for
# $table_name. Wire this into the target project's databricks.yml with an `include:` entry
# (e.g. `include: [resources/*.yml]`) if it doesn't already have one -- data-deploy writes only to
# output_dir, never to a client project's own databricks.yml file directly; a human takes the
# generated file from there. See references/asset-bundle-resources.md.
#
# Depends on the connection declared in uc_connection.yml (same directory) already existing in the
# target workspace -- see that file's header for how to create it.
#
# Generating this file does not run `databricks bundle deploy`, create the pipeline, or start any
# ingestion -- see references/approval-gate.md and toolkit-conventions.md #1 and #7.

resources:
  pipelines:
    ${table_name}_ingestion:
      name: "${table_name}_ingestion"
      catalog: "$target_catalog"
      schema: "$target_schema"
      ingestion_definition:
        connection_name: "$connection_name"
        objects:
          - table:
              source_schema: "$source_schema"
              source_table: "$source_table"
              destination_catalog: "$target_catalog"
              destination_schema: "$target_schema"
              destination_table: "$table_name"$primary_keys_block
