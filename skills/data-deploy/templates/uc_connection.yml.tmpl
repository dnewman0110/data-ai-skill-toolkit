# Generated by data-deploy (toolkit) -- the Unity Catalog connection $table_name's ingestion
# pipeline depends on.
#
# A UC connection is normally created ONCE per source system/credential and reused across every
# pipeline that ingests from it -- this file documents the connection, it does not create it as a
# bundle-native resource. Databricks Asset Bundles do not have confirmed first-class support for
# creating UC connections as of this template's writing; the shape below is templated from the
# Terraform provider's `databricks_connection` resource schema. Create the connection once, before
# deploying the ingestion pipeline resource in this same directory, via EITHER:
#   databricks connections create --json '{"name": "$connection_name", "connection_type": "$connector_type", "options": {...}}'
# OR the Terraform `databricks_connection` resource with the equivalent shape. See
# references/asset-bundle-resources.md, and verify this shape against your workspace's actual
# Databricks CLI/Terraform provider version before deploying -- same "verify against live before
# an engagement" discipline as the rest of this toolkit (see DECISIONS.md decision 58).
#
# Auth: $auth_note
#
# Generating this file does not create the connection, run `databricks bundle deploy`, or touch
# any client workspace -- see references/approval-gate.md and toolkit-conventions.md #1 and #7.

connection:
  name: "$connection_name"
  connection_type: "$connector_type"
  options:
$connection_options_yaml
