from pyspark.sql import functions as F

SOURCE_TABLE = "$source_catalog.$source_schema.$source_table"
TARGET_TABLE = "$target_catalog.$target_schema.$target_table"
MERGE_KEYS = $merge_keys_pylist

df = spark.table(SOURCE_TABLE).select(
$select_lines
)

if MERGE_KEYS:
    # Idempotent upsert keyed on MERGE_KEYS. Restart semantics: safe to re-run from the start on
    # failure -- MERGE is naturally idempotent against unchanged source rows, so a retry after a
    # partial failure does not double-apply already-merged rows.
    from delta.tables import DeltaTable

    target = DeltaTable.forName(spark, TARGET_TABLE)
    merge_condition = " AND ".join(f"target.{k} = source.{k}" for k in MERGE_KEYS)
    (
        target.alias("target")
        .merge(df.alias("source"), merge_condition)
        .whenMatchedUpdateAll()
        .whenNotMatchedInsertAll()
        .execute()
    )
else:
    # full_refresh: no declared merge key, so idempotency comes from atomic overwrite rather than
    # upsert -- a restart after failure simply re-runs the same overwrite, not a partial append.
    df.write.mode("overwrite").option("overwriteSchema", "false").saveAsTable(TARGET_TABLE)
