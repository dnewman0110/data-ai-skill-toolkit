# Client data must never enter this repo. See README.md "Contribution rules".

# Run outputs, scratch, and local config -- always outside the repo in principle
# (output_dir defaults to ~/.toolkit-runs/...), but excluded here too as defense in depth
# in case a project-local override points output_dir back under the repo by mistake.
/output/
/outputs/
/scratch/
/.toolkit-runs/
toolkit.yaml
*.local.yaml

# Fixture overrides: a project may drop client-shaped (but synthetic) fixtures locally to
# extend eval coverage without touching the shared fixtures/ the whole toolkit ships with.
# These are local-only by convention and never committed upstream.
fixtures/local-overrides/

# Skill-creator eval workspaces (iteration-N/, benchmark outputs) -- reproducible from
# evals/evals.json + fixtures/, not meant to be versioned.
*-workspace/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# OS / editor cruft
.DS_Store
.vscode/
*.swp

# Fixture lakehouse database files are generated from fixtures/generate_fixtures.py (SQLite,
# chosen so evals need zero external dependencies -- see DECISIONS.md) -- keep the generator,
# not the binary artifacts it produces.
fixtures/lakehouse/*.db
fixtures/lakehouse/*.db-journal
*.duckdb

# fixtures/integration_check.py's output -- regenerated by every run (CI or local), same
# generated-not-committed treatment as fixtures/lakehouse/*.db above. Keep the script, not what
# it produces.
fixtures/integration/*.json
fixtures/integration/pipeline/
